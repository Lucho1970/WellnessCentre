APP_ENV=development
APP_KEY=replace-with-a-long-random-secret
APP_DEBUG=false
# Opt-in pilot: empty JSON lists deny all protected identities and all email/SMS delivery.
# Match verified identities, never email/display names. Configure approved subjects before enabling.
# See documentation/PILOT_SAFETY_CONTROLS.md; do not put real tester lists in this example.
PILOT_MODE=false
PILOT_ALLOWED_IDENTITIES=[]
PILOT_ALLOWED_EMAILS=[]
PILOT_ALLOWED_SMS=[]
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Exact API request authorities mapped to active database clinic IDs.
# Replace 1 with the verified clinic ID; configure every production host before deploying.
CLINIC_HOST_MAP={"localhost:8080":1,"livinlively.com":1,"www.livinlively.com":1,"livinlively.copihue.ca":1}

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wellness_centre
DB_USER=wellness1
DB_PASSWORD=replace-with-your-local-database-password

# Microsoft Entra workforce authentication (unchanged)
ENTRA_TENANT_ID=dcbc99f5-04a8-40d6-8a2e-69633e3673ff
ENTRA_API_CLIENT_ID=923bdf31-87c8-44c7-9396-3d3860b7e678
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_JWKS_CACHE_SECONDS=3600

# Optional External ID customer authentication, separate from workforce trust.
CUSTOMER_ENTRA_TENANT_ID=
CUSTOMER_ENTRA_SUBDOMAIN=
CUSTOMER_ENTRA_API_CLIENT_ID=
CUSTOMER_ENTRA_SPA_CLIENT_ID=

GOOGLE_MAPS_API_KEY=your-restricted-server-key
ADDRESS_VALIDATION_SIGNING_KEY=your-generated-random-key
ADDRESS_VALIDATION_TOKEN_TTL_SECONDS=900

# Optional Microsoft Graph appointment mailer. Configure a dedicated Exchange Online mailbox.
MAIL_ENABLED=false
MAIL_TRIGGER_SECRET=
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_FROM_ADDRESS=wellness@lucho1970.onmicrosoft.com
CLIENT_PORTAL_URL=https://livinlively.copihue.ca/client

  # VoIP.ms staff appointment texts to Canadian numbers only. Keep false until deliberately activated.
# API credentials belong only in the private wellness-api/.env, never a public file.
SMS_ENABLED=false
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
VOIPMS_FROM_DID=2892975234

# Temporary one-time hosted diagnostic only; leave disabled during normal operation.
SMS_TEST_ENABLED=false
SMS_TEST_SECRET=
SMS_TEST_TO=

# Public navigation destination, loaded at runtime by both frontends.
PUBLIC_WEBSITE_URL=https://livinlively.com/

# Disabled until selected staff memberships have been reconciled and imported.
STAFF_MEMBERSHIP_PILOT_ENABLED=false
STAFF_MEMBERSHIP_PILOT_USER_IDS=

# Separate External ID practitioner invitation pilot; leave disabled until configured and tested.
STAFF_INVITATIONS_ENABLED=false
STAFF_EXTERNAL_TENANT_ID=
STAFF_EXTERNAL_SUBDOMAIN=
STAFF_EXTERNAL_API_CLIENT_ID=
STAFF_EXTERNAL_SPA_CLIENT_ID=

# Apply migration 034 and deploy the portal before enabling secure appointment email links.
APPOINTMENT_ACTION_LINKS_ENABLED=false

# Apply migration 036 and verify synthetic forms before enabling the pilot.
CLIENT_FORMS_ENABLED=false
# Maximum questions per form (1-200); invalid/unset values use 100.
FORM_TEMPLATE_MAX_QUESTIONS=100
# Apply migration 037 before enabling private form-author drafts.
FORM_TEMPLATE_DRAFTS_ENABLED=false
# Apply migration 041 before enabling client-answer drafts and append-only amendments.
CLIENT_FORM_ANSWERS_ENABLED=false

# Apply migration 039 before enabling clinic provisioning and clinic-bound client sessions.
# Keep CLINIC_HOST_MAP for existing hosts; new clinic hosts are registered by Super Admin.
CLINIC_MANAGEMENT_ENABLED=false

# Central administration requires migration 040 and explicit identity grants.
APPLICATION_ADMIN_ENABLED=false
APPLICATION_ADMIN_HOST=portal.copihue.ca

# Install 053 and 054 before enabling central billing configuration/monitoring.
# This does not activate provider billing or connect SMS sending to budget enforcement.
BILLING_ADMIN_ENABLED=false

# Install 055 and configure reviewed per-clinic joining terms/plan before opening applications.
PRACTITIONER_APPLICATIONS_ENABLED=false
# Independent-practitioner isolation and hosted identity/MFA acceptance are separate rollout gates.
PRACTITIONER_APPLICATION_ACTIVATION_ENABLED=false
# Durable sign-in for approved external practitioners, independent from intake/invitation switches.
STAFF_EXTERNAL_AUTH_ENABLED=false

# Apply 056 and configure each clinic before enabling. No live resources are purchased.
AUTOMATED_COMMUNICATIONS_ENABLED=false
SMS_BUDGET_ENFORCEMENT_ENABLED=false
PROVIDER_EVIDENCE_ENABLED=false

# Enable only after migration 043 and receipt template/issuer acceptance.
SESSION_RECEIPTS_ENABLED=false

# Reusable approved global/clinic forms; install migration 045 first.
FORM_LIBRARY_ENABLED=false
