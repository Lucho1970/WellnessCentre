APP_ENV=development
APP_KEY=replace-with-a-long-random-secret
APP_DEBUG=false
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wellness_centre
DB_USER=wellness_app
DB_PASSWORD=replace-with-your-local-database-password

# Microsoft Entra staff/client authentication
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_JWKS_CACHE_SECONDS=3600
