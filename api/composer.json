{
  "name": "wellness-centre/internal-api",
  "description": "Internal API for the Wellness Centre scheduling platform",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "firebase/php-jwt": "^7.1",
    "nikic/fast-route": "^1.3"
  },
  "autoload": {
    "psr-4": { "Wellness\\": "src/" }
  },
  "scripts": {
    "lint": "@php -r \"foreach(new RecursiveIteratorIterator(new RecursiveDirectoryIterator('src')) as $f){if($f->getExtension()==='php'){passthru('php -l '.escapeshellarg($f),$c);if($c)exit($c);}}\""
  },
  "config": { "sort-packages": true }
}
