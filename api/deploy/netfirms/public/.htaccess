RewriteEngine On
# API directory rules do not inherit the portal root rewrite rules.
# Refuse plaintext requests before the PHP front controller receives them.
RewriteCond %{HTTPS} !=on
RewriteRule ^ - [F,L]
RewriteBase /api/

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
