{
  "name": "wellness-centre-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:portal": "vite --config vite.portal.config.ts",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run validate:content && tsc --noEmit && npm run build:public && npm run build:portal",
    "build:public": "vite build --config vite.config.ts",
    "build:portal": "vite build --config vite.portal.config.ts",
    "preview:public": "vite preview --config vite.config.ts",
    "preview:portal": "vite preview --config vite.portal.config.ts",
    "lint": "eslint .",
    "test": "playwright test",
    "test:build": "npm run build && playwright test --config playwright.build.config.ts",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0",
    "@azure/msal-react": "^5.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "date-fns": "^4.1.0",
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/google.maps": "^3.66.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
