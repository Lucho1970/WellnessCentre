VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Optional isolated customer sign-in; all four values are required. No secrets.
VITE_CUSTOMER_ENTRA_TENANT_ID=
VITE_CUSTOMER_ENTRA_SUBDOMAIN=
VITE_CUSTOMER_ENTRA_SPA_CLIENT_ID=
VITE_CUSTOMER_ENTRA_API_CLIENT_ID=
# Browser-visible key restricted to approved HTTP referrers, Maps JavaScript API,
# and Places API (New). Never use the private Address Validation/Routes key here.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
# Used by development and the public build. Production portal builds deliberately
# use /api/v1 on the portal host, backed by the shared private PHP application.

# Local development runs two Vite servers: npm run dev and npm run dev:portal.
# For deployment set both URLs to the actual HTTPS hosts BEFORE building.
# An absolute portal subdomain URL ending in / produces a root-hosted portal.
# If omitted, production defaults to public / and portal /portal/ on one host.
# VITE_PUBLIC_URL=https://wellness.copihue.ca/
# VITE_PORTAL_URL=https://YOUR-PORTAL-HOST/
# Optional override; defaults to the portal build's origin + base path.
# Must be an exact registered SPA redirect URI on the portal host, not the public site.
# VITE_ENTRA_REDIRECT_URI=https://YOUR-PORTAL-HOST/
