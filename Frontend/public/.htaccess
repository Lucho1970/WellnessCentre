RewriteEngine On

# Canonical public website: https://livinlively.ca
# Keep 302 while verifying the switch to avoid permanently cached redirects.
RewriteCond %{HTTP_HOST} ^(www\.)?livinlively\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.livinlively\.ca$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://livinlively.ca/$1 [R=302,L]

# The SPA shell selects the current hashed JS/CSS files. Apply to index.html
# after directory-index resolution and SPA rewrites, not API or asset responses.
<Files "index.html">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header onsuccess unset Cache-Control
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header onsuccess unset Expires
        Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    </IfModule>
</Files>

# API errors must not become successful SPA HTML responses.
RewriteRule ^api(?:/|$) - [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
