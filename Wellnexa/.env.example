# Public browser configuration only. Never put credentials or API secrets here.
VITE_PORTAL_URL=https://wellnexa.copihue.ca/
# Enable only with the matching portal build and approved per-clinic application settings.
VITE_PRACTITIONER_APPLICATIONS_ENABLED=false
# Keep existing practitioner sign-in available when intake is closed; requires the portal/API setup.
VITE_STAFF_EXTERNAL_AUTH_ENABLED=false
